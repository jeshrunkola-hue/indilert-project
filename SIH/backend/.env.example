# =========================================================
# FASTAPI BACKEND Environment Variables
# =========================================================

# 1. Server Port (automatically set by Render/Railway/Fly.io)
PORT=8000

# 2. Database Connection
# SQLite (default for file-based or persistent disk):
DATABASE_URL=sqlite:///./ner_safe.db
# PostgreSQL (production recommended for cloud hosts):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# 3. Allowed CORS Origins (Comma-separated, NO unrestricted wildcard)
# Local development:
# CORS_ORIGINS=http://localhost:5174,http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:3000
# Production with Netlify:
CORS_ORIGINS=https://YOUR-INDILERT-ADMIN-NETLIFY-URL.netlify.app,https://YOUR-INDILERT-CITIZEN-NETLIFY-URL.netlify.app,http://localhost:5174,http://localhost:3000

# 4. Public URLs
BACKEND_PUBLIC_URL=https://YOUR-BACKEND-HOSTING-URL.onrender.com
INDILERT_URL=https://YOUR-INDILERT-CITIZEN-NETLIFY-URL.netlify.app

# 5. Security & Authentication
SECRET_KEY=ner-safe-production-disaster-resilience-secret-key-change-in-prod-2026

# 6. Web Push VAPID Protocol Keys
VAPID_PUBLIC_KEY=BKAjIB-FoW07V4aqTK2X7_zcGb6geRxZmfOOfk9lNJP3-rYoz9Z0fdupcntc6aHA7N5nE2tN6gRk_kwZGOq_qIQ
VAPID_PRIVATE_KEY=NIrUIOhTEwSpx-ZpSEZ0xTLHPruE9HW7u1h_e3X_IEc
VAPID_CLAIMS_EMAIL=mailto:alerts@nersafe.gov.in
