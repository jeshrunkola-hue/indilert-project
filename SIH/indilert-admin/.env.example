# =========================================================
# INDILERT ADMIN (Government/Admin Frontend) Environment Variables
# =========================================================

# 1. FastAPI Production Backend Public URL (HTTPS, no trailing slash)
# Example: https://your-backend-api.onrender.com
VITE_API_URL=https://YOUR-PUBLIC-FASTAPI-URL

# 2. (Optional) Real-time WebSocket URL
# If omitted, it will automatically derive wss:// from VITE_API_URL
# Example: wss://your-backend-api.onrender.com/ws/live
# VITE_WS_URL=wss://YOUR-PUBLIC-FASTAPI-URL/ws/live

# 3. (Optional) Citizen Application Netlify URL
# Example: https://your-citizen-app.netlify.app
# VITE_INDILERT_URL=https://YOUR-CITIZEN-NETLIFY-URL
